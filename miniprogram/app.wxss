@import "./theme-overrides.wxss";
page{background:#f7f3ee;color:#292421;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:30rpx 28rpx 56rpx;box-sizing:border-box}.title{font-size:46rpx;line-height:1.2;font-weight:900;letter-spacing:-1rpx;color:#292421}.subtitle{color:#817873;margin-top:8rpx;font-weight:600}.card{background:#fffcf8;border:3rpx solid #e9e0d8;border-radius:28rpx;padding:28rpx;margin-top:24rpx;box-shadow:0 7rpx 0 #dccfc4;box-sizing:border-box}.row{display:flex;align-items:center}.between{display:flex;align-items:center;justify-content:space-between}.muted{color:#817873}.primary{background:#f56b52!important;color:#fff!important;border-radius:22rpx;font-weight:900;border:0!important;box-shadow:0 7rpx 0 #d6533d}.primary:active{transform:translateY(5rpx) scale(.99);box-shadow:0 2rpx 0 #d6533d}.secondary{background:#756a9c!important;color:#fff!important;border-radius:22rpx;font-weight:900;border:0!important;box-shadow:0 7rpx 0 #5d537e}.secondary:active{transform:translateY(5rpx) scale(.99);box-shadow:0 2rpx 0 #5d537e}.tag{display:inline-flex;padding:8rpx 16rpx;border-radius:999rpx;background:#eeeaf5;color:#665b89;font-size:24rpx;font-weight:800;margin-right:10rpx}.grade{display:inline-flex;width:70rpx;height:70rpx;border-radius:20rpx;align-items:center;justify-content:center;background:#f56b52;color:#fff;font-weight:900;box-shadow:0 5rpx 0 #d6533d}.avatar{width:76rpx;height:76rpx;border-radius:50%;background:#f0ebe6;border:3rpx solid #e5d9cf}.empty{text-align:center;padding:90rpx 30rpx;color:#817873;font-weight:700}.ui-icon{width:38rpx;height:38rpx;flex:none}.section-heading{display:flex;align-items:center;gap:12rpx}.icon-badge{width:54rpx;height:54rpx;display:inline-flex;align-items:center;justify-content:center;background:#f7e9e3;border-radius:17rpx}.icon-badge .ui-icon{width:34rpx;height:34rpx}.round-arrow{width:28rpx;height:28rpx;border-right:4rpx solid currentColor;border-top:4rpx solid currentColor;transform:rotate(45deg);border-radius:3rpx}button::after{border:0}
@keyframes cardEnter{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}.card,.gym-row,.meetup-card{animation:cardEnter .26s cubic-bezier(.2,.8,.2,1) both}.card,.gym-row,.meetup-card,.month-arrow,.calendar-day,.tabs view,.scope-tabs view,.achievement,.route,.menu,.primary,.secondary{transition:transform .12s ease,box-shadow .12s ease,background-color .16s ease,border-color .16s ease}.card:active,.gym-row:active,.meetup-card:active,.menu:active,.route:active{transform:translateY(4rpx) scale(.992)!important;box-shadow:0 2rpx 0 #dccfc4!important}.month-arrow:active,.calendar-day:active,.tabs view:active,.scope-tabs view:active,.achievement:active{transform:scale(.94)!important}.actions text,.meetup-link,.clear{transition:transform .12s ease,color .12s ease}.actions text:active,.meetup-link:active,.clear:active{transform:scale(.9)}
.head-cat,.feed-head>image,.league-cat,.growth-cat image,.loading-cat,.success-cat,.cat-perch image{animation:none!important}
