page{background:#fff8e9;color:#24343c}.earned-page{padding:48rpx 40rpx 60rpx;text-align:center}.kicker{font-size:26rpx;color:#8f6c38;font-weight:800;letter-spacing:4rpx}.badge-stage{display:flex;align-items:center;justify-content:center;margin:16rpx auto 8rpx;transform-origin:50% 55%}.title{font-size:40rpx;font-weight:800;line-height:1.5}.copy{font-size:25rpx;line-height:1.7;color:#69777e;margin-top:12rpx}.sound-setting{display:flex;align-items:center;justify-content:space-between;text-align:left;background:#fffdf7;border:2rpx solid #e9dcc7;border-radius:24rpx;padding:20rpx 24rpx;margin-top:32rpx;font-size:26rpx}.sound-setting text{font-size:22rpx;color:#69777e}.replay,.collection{background:transparent;color:#69777e;font-size:25rpx;margin:12rpx 0;min-height:88rpx;line-height:88rpx}.replay::after,.collection::after{border:0}.primary{min-height:96rpx;line-height:96rpx;background:#ff6b52;color:#fff;font-size:29rpx;font-weight:800;border-radius:28rpx;box-shadow:0 6rpx 0 #d94f3a}.state{padding:100rpx 0;font-size:27rpx;line-height:1.7}.state button{margin-top:24rpx}.is-playing{animation:badge-arrive 1100ms both}@keyframes badge-arrive{0%{transform:scale(.68);opacity:.3}40%{transform:scale(1.06);opacity:1}82%,100%{transform:scale(1);opacity:1}}.reduced{animation:none}@media(prefers-reduced-motion:reduce){.is-playing{animation:none}}
