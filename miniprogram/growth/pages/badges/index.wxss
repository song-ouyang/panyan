page{background:#fff8e9;color:#24343c}.badges-page{padding:32rpx}.level-summary{display:flex;align-items:center;gap:14rpx}.level-copy{flex:1;min-width:0}.eyebrow{color:#69777e;font-size:22rpx}.title{font-size:34rpx;line-height:1.4;font-weight:800}.copy{font-size:24rpx;line-height:1.65;color:#69777e;margin-top:12rpx}.progress-card,.rules{background:#fffdf7;border:2rpx solid #e9dcc7;border-radius:32rpx;padding:28rpx;margin-top:28rpx}.subtitle{font-size:27rpx;font-weight:800}.metric{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx;font-size:25rpx;margin:24rpx 0 12rpx}.track{height:16rpx;border-radius:16rpx;background:#f0e6d5;overflow:hidden}.fill{height:100%;border-radius:16rpx;background:#ff6b52}.fill.days{background:#9a78e8}.collection-heading{display:flex;justify-content:space-between;font-weight:800;font-size:30rpx;margin:36rpx 0 20rpx}.collection-heading text{font-size:22rpx;color:#69777e;font-weight:400}.badge-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.badge-cell{display:flex;flex-direction:column;align-items:center;text-align:center;min-width:0;border-radius:28rpx;border:2rpx solid #e9dcc7;background:#fffdf7;padding:16rpx 8rpx 22rpx}.badge-name{font-size:25rpx;font-weight:800;line-height:1.5}.badge-status{color:#69777e;font-size:23rpx;margin-top:8rpx}.earned .badge-status{color:#786021}.revoked .badge-status{color:#a25443}.badge-requirement{font-size:21rpx;color:#69777e;margin-top:6rpx}.rules{font-size:23rpx;line-height:1.7;color:#69777e}.rules view+view{margin-top:14rpx}.state{padding:100rpx 24rpx;text-align:center}.state button{margin-top:28rpx}.error{padding:24rpx;background:#fff1ed;border-radius:24rpx;display:flex;gap:16rpx;align-items:center}.error text{flex:1}.error button{flex-shrink:0;min-height:88rpx;line-height:88rpx}
