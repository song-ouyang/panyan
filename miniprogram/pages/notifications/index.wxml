<view class="page"><view class="card notice pressable {{item.read_at?'':'unread'}}" wx:for="{{items}}" wx:key="id" data-item="{{item}}" bindtap="open" role="button" aria-label="{{item.title}}"><view class="dot"></view><view class="body"><view class="between"><view class="name">{{item.title}}</view><view class="muted time">{{item.created_at}}</view></view><view class="muted">{{item.content}}</view></view><text>›</text></view><view class="empty" wx:if="{{!loading && !items.length}}">暂时没有新消息</view></view>
