<view class="page" wx:if="{{post}}"><view class="card"><view class="row"><image class="avatar" src="{{post.avatar_url || '/assets/logo.png'}}"/><view class="who"><view>{{post.nickname}}</view><view class="muted">{{post.gym_name}} · {{post.route_name}}</view></view><view class="grade">{{post.grade}}</view></view><video wx:if="{{post.video_url}}" src="{{post.video_url}}" controls object-fit="cover"></video><view class="caption">{{post.caption || '完成了这条线路'}}</view><view class="actions"><text bindtap="like">{{post.liked?'♥':'♡'}} {{post.like_count}}</text><button open-type="share">分享给岩友</button><text class="report" bindtap="report">举报</text></view></view>
<view class="section-title">评论</view><view class="comment card" wx:for="{{post.comments}}" wx:key="id"><image class="avatar small" src="{{item.avatar_url || '/assets/logo.png'}}"/><view><view class="name">{{item.nickname}}</view><view>{{item.content}}</view></view></view><view class="empty" wx:if="{{!post.comments.length}}">来留下第一条评论</view><view class="composer"><input placeholder="友善交流，分享Beta…" value="{{content}}" bindinput="input"/><button class="primary" loading="{{sending}}" bindtap="sendComment">发送</button></view></view>
