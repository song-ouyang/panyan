<view class="page"><view class="title">我的岩友</view><view class="search row"><input placeholder="搜索岩友昵称" bindinput="input" confirm-type="search" bindconfirm="search"/><button bindtap="search">搜索</button></view><view class="section" wx:if="{{requests.length}}"><view class="section-title">好友申请</view><view class="person card" wx:for="{{requests}}" wx:key="id"><image class="avatar" src="{{item.avatar_url || '/assets/logo.png'}}"/><view class="name">{{item.nickname}}</view><button size="mini" class="primary" data-id="{{item.id}}" bindtap="accept">接受</button></view></view><view class="section" wx:if="{{results.length}}"><view class="section-title">搜索结果</view><view class="person card" wx:for="{{results}}" wx:key="id"><image class="avatar" src="{{item.avatar_url || '/assets/logo.png'}}"/><view class="name"><view>{{item.nickname}}</view><view class="muted">{{item.bio || '热爱抱石的岩友'}}</view></view><button wx:if="{{item.friendship==='none'}}" size="mini" class="primary" data-id="{{item.id}}" bindtap="add">加岩友</button><text wx:else class="muted">{{item.friendship==='accepted'?'已是岩友':item.friendship==='received'?'待你接受':'已申请'}}</text></view></view><view class="section"><view class="section-title">全部岩友 · {{friends.length}}</view><view class="person card" wx:for="{{friends}}" wx:key="id"><image class="avatar" src="{{item.avatar_url || '/assets/logo.png'}}"/><view class="name">{{item.nickname}}</view><text class="remove" data-id="{{item.id}}" bindtap="remove">删除</text></view><view class="empty" wx:if="{{!friends.length}}">搜索昵称，添加第一位岩友</view></view></view>
