.search{min-height:88rpx;box-sizing:border-box;background:#f5f6f4;border:2rpx solid transparent;border-radius:24rpx;padding:8rpx 8rpx 8rpx 26rpx;margin-top:28rpx}.search:focus-within{background:#fff;border-color:#cfd3cf}.search input{flex:1}.search button{min-width:112rpx;min-height:72rpx;margin:0;border:0;border-radius:18rpx;background:#25282d;color:#fff;font-size:24rpx}.section{margin-top:36rpx}.section-title{font-size:34rpx;font-weight:850}.person{display:flex;align-items:center}.name{flex:1;margin-left:18rpx;font-weight:700}.name .muted{font-size:23rpx;font-weight:400}.remove{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:flex-end;color:#b54848;font-size:24rpx}
