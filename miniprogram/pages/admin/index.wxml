<view class="page"><view class="title">审核管理中心</view><view class="tabs"><view class="{{tab==='routes'?'active':''}}" data-tab="routes" bindtap="tab">线路 {{routes.length}}</view><view class="{{tab==='content'?'active':''}}" data-tab="content" bindtap="tab">内容 {{sends.length+comments.length}}</view><view class="{{tab==='reports'?'active':''}}" data-tab="reports" bindtap="tab">举报 {{reports.length}}</view></view>
<block wx:if="{{tab==='routes'}}"><view class="card review" wx:for="{{routes}}" wx:key="id"><image src="{{item.cover_url}}" mode="aspectFill"/><view class="body"><view class="name">{{item.name}} · {{item.grade}}</view><view class="muted">{{item.gym_name}} · {{item.wall_zone}} · {{item.submitter_name}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="reviewRoute">拒绝</button><button size="mini" class="primary" data-id="{{item.id}}" data-action="approve" bindtap="reviewRoute">通过发布</button></view></view></view><view class="empty" wx:if="{{!routes.length}}">没有待审线路</view></block>
<block wx:if="{{tab==='content'}}"><view class="card content" wx:for="{{sends}}" wx:key="id"><view class="name">动态 · {{item.nickname}}</view><view>{{item.caption || '视频打卡'}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" data-type="send" data-action="reject" bindtap="reviewContent">拒绝</button><button size="mini" class="primary" data-id="{{item.id}}" data-type="send" data-action="approve" bindtap="reviewContent">通过</button></view></view><view class="card content" wx:for="{{comments}}" wx:key="id"><view class="name">评论 · {{item.nickname}}</view><view>{{item.content}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" data-type="comment" data-action="reject" bindtap="reviewContent">拒绝</button><button size="mini" class="primary" data-id="{{item.id}}" data-type="comment" data-action="approve" bindtap="reviewContent">通过</button></view></view><view class="empty" wx:if="{{!sends.length && !comments.length}}">没有待审内容</view></block>
<block wx:if="{{tab==='reports'}}"><view class="card content" wx:for="{{reports}}" wx:key="id"><view class="name">{{item.target_type}} · {{item.reason}}</view><view class="muted">目标：{{item.target_id}}</view><view>{{item.detail || '用户未补充说明'}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" data-type="report" data-action="reject" bindtap="reviewContent">忽略</button><button size="mini" class="primary" data-id="{{item.id}}" data-type="report" data-action="approve" bindtap="reviewContent">确认处理</button></view></view><view class="empty" wx:if="{{!reports.length}}">没有待处理举报</view></block></view>
