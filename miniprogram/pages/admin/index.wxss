.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#eee8df;border-radius:999rpx;padding:8rpx;margin-top:30rpx}.tabs view{text-align:center;padding:14rpx;border-radius:999rpx}.tabs .active{background:#181716;color:#fff}.review{display:flex}.review image{width:180rpx;height:180rpx;border-radius:20rpx}.body{flex:1;margin-left:20rpx}.name{font-size:30rpx;font-weight:750}.actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:22rpx}.actions button{margin:0}.content{line-height:1.7}
