.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#f1f2f0;border-radius:22rpx;padding:6rpx;margin-top:30rpx}.tabs view{min-height:76rpx;display:flex;align-items:center;justify-content:center;text-align:center;border-radius:18rpx;color:#737b84}.tabs .active{background:#fff;color:#25282d;box-shadow:0 2rpx 10rpx rgba(17,24,39,.07)}.review{display:flex}.review image{width:180rpx;height:180rpx;border-radius:20rpx}.body{flex:1;margin-left:20rpx}.name{font-size:30rpx;font-weight:800}.actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:22rpx}.actions button{min-height:72rpx;margin:0}.content{line-height:1.7}
