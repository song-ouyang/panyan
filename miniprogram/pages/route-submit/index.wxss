.wall-wrap{position:relative;margin-top:28rpx;border:2rpx solid #e4e6e3;border-radius:28rpx;overflow:hidden;background:#f3f4f2;min-height:420rpx}.wall-wrap image{width:100%;display:block}.wall-empty{height:520rpx;display:flex;align-items:center;justify-content:center;color:var(--color-accent-strong)}.marker{position:absolute;width:44rpx;height:44rpx;margin:-22rpx;border-radius:50%;background:var(--color-accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx;border:4rpx solid #fff}.marker.start{background:#26a269}.marker.finish{background:#25282d}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:24rpx}.tools button{min-height:88rpx;font-size:24rpx;border-radius:20rpx;background:#f5f6f4;color:#525962}.tools .active{background:var(--color-accent);color:#fff}.mini-tools{min-height:88rpx;padding:0 20rpx;color:var(--color-muted)}.mini-tools text{min-width:120rpx;min-height:88rpx;display:flex;align-items:center}.mini-tools text:last-child{justify-content:flex-end}.form input,.picker{background:#f5f6f4;padding:22rpx;border-radius:16rpx;margin-bottom:16rpx}.submit{margin-top:28rpx}

.draft-notice{padding:24rpx;color:#8f493b;background:#fff1eb;border-radius:24rpx;line-height:1.6;margin-top:18rpx}
