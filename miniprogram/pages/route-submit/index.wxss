.wall-wrap{position:relative;margin-top:28rpx;border-radius:28rpx;overflow:hidden;background:#e8e1d8;min-height:420rpx}.wall-wrap image{width:100%;display:block}.wall-empty{height:520rpx;display:flex;align-items:center;justify-content:center;color:#ff6648}.marker{position:absolute;width:44rpx;height:44rpx;margin:-22rpx;border-radius:50%;background:#ff6648;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx;border:4rpx solid #fff}.marker.start{background:#26a269}.marker.finish{background:#181716}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:24rpx}.tools button{font-size:24rpx;border-radius:999rpx}.tools .active{background:#ff6648;color:#fff}.mini-tools{padding:20rpx;color:#7b746c}.form input,.picker{background:#f5f1eb;padding:22rpx;border-radius:16rpx;margin-bottom:16rpx}.submit{margin-top:28rpx}

