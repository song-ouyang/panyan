<view class="page"><view wx:if="{{error}}" class="draft-notice">{{error}}</view><view wx:if="{{draftLocked}}" class="draft-notice">继续保存上次投稿，重试不会重复创建线路。</view><view class="title">标记一条线路</view><view class="subtitle">上传正面岩壁照片，依次点选起步、岩点和终点。提交后会立即发布。</view><button wx:if="{{draftLocked}}" disabled="{{submitting}}" bindtap="newSubmission">新建线路草稿</button><view class="wall-wrap" bindtap="addPoint"><image wx:if="{{imagePath}}" id="wallImage" src="{{imagePath}}" mode="widthFix"/><view wx:else class="wall-empty pressable" role="button" aria-label="拍摄或选择岩壁照片" catchtap="chooseImage">＋ 拍摄或选择岩壁照片</view><view wx:for="{{points}}" wx:key="index" catchtap="noop" class="marker {{item.type}}" style="left:{{item.x*100}}%;top:{{item.y*100}}%">{{item.type==='start'?'S':item.type==='finish'?'T':index+1}}</view></view><button wx:if="{{imagePath}}" class="pressable" size="mini" bindtap="chooseImage">更换照片</button><view class="tools"><button class="pressable {{pointType==='start'?'active':''}}" data-type="start" bindtap="chooseType">起步点</button><button class="pressable {{pointType==='hold'?'active':''}}" data-type="hold" bindtap="chooseType">途经点</button><button class="pressable {{pointType==='finish'?'active':''}}" data-type="finish" bindtap="chooseType">终点</button></view><view class="between mini-tools"><text class="pressable" role="button" bindtap="undo">撤销上一步</text><text class="pressable" role="button" bindtap="clear">清空标点</text></view><view class="form card"><input placeholder="线路名称，如：橙色动态线" value="{{name}}" disabled="{{draftLocked || submitting}}" data-key="name" bindinput="input"/><picker range="{{grades}}" value="{{gradeIndex}}" disabled="{{draftLocked || submitting}}" bindchange="grade"><view class="picker pressable">难度：{{grades[gradeIndex]}}</view></picker><input placeholder="线路颜色，如：珊瑚橙" value="{{color}}" disabled="{{draftLocked || submitting}}" data-key="color" bindinput="input"/><input placeholder="墙面区域，如：A区斜墙" value="{{wallZone}}" disabled="{{draftLocked || submitting}}" data-key="wallZone" bindinput="input"/></view><button class="primary primary-action pressable submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{draftLocked ? "重试保存线路" : "立即发布线路"}}</button></view>
