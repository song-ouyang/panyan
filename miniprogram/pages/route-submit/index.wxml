<view class="page"><view class="title">标记一条线路</view><view class="subtitle">上传正面岩壁照片，依次点选起步、岩点和终点。</view><view class="wall-wrap" bindtap="addPoint"><image wx:if="{{imagePath}}" id="wallImage" src="{{imagePath}}" mode="widthFix"/><view wx:else class="wall-empty" catchtap="chooseImage">＋ 拍摄或选择岩壁照片</view><view wx:for="{{points}}" wx:key="index" catchtap="noop" class="marker {{item.type}}" style="left:{{item.x*100}}%;top:{{item.y*100}}%">{{item.type==='start'?'S':item.type==='finish'?'T':index+1}}</view></view><button wx:if="{{imagePath}}" size="mini" bindtap="chooseImage">更换照片</button><view class="tools"><button class="{{pointType==='start'?'active':''}}" data-type="start" bindtap="chooseType">起步点</button><button class="{{pointType==='hold'?'active':''}}" data-type="hold" bindtap="chooseType">途经点</button><button class="{{pointType==='finish'?'active':''}}" data-type="finish" bindtap="chooseType">终点</button></view><view class="between mini-tools"><text bindtap="undo">撤销上一步</text><text bindtap="clear">清空标点</text></view><view class="form card"><input placeholder="线路名称，如：橙色动态线" data-key="name" bindinput="input"/><picker range="{{grades}}" value="{{gradeIndex}}" bindchange="grade"><view class="picker">难度：{{grades[gradeIndex]}}</view></picker><input placeholder="线路颜色，如：珊瑚橙" data-key="color" bindinput="input"/><input placeholder="墙面区域，如：A区斜墙" data-key="wallZone" bindinput="input"/></view><button class="primary submit" loading="{{submitting}}" bindtap="submit">提交岩馆审核</button></view>
