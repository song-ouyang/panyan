<view class="page"><view class="card post" wx:for="{{items}}" wx:key="id"><view class="between" data-id="{{item.id}}" bindtap="open"><view><view class="name">{{item.gym_name}} · {{item.route_name}}</view><view class="muted">{{item.grade}} · 尝试{{item.attempts}}次</view></view><view class="status {{item.moderation_status}}">{{item.moderation_status==='approved'?'已发布':item.moderation_status==='pending'?'审核中':'未通过'}}</view></view><view class="caption">{{item.caption || '完成了这条线路'}}</view><view class="between foot"><text class="tag">{{item.visibility==='public'?'公开':item.visibility==='friends'?'岩友可见':'仅自己'}}</text><text class="delete" data-id="{{item.id}}" bindtap="remove">删除</text></view></view><view class="empty" wx:if="{{!loading && !items.length}}">还没有完攀打卡</view></view>
