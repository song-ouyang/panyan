page{background:#f7faf5}.gym-page{min-height:100vh}.black-head{min-height:286rpx;background:linear-gradient(145deg,#dfffd0,#f4ffe9);display:flex;align-items:center;justify-content:space-between;padding:34rpx 40rpx 40rpx;box-sizing:border-box;border-radius:0 0 48rpx 48rpx;border-bottom:4rpx solid #bceca0;box-shadow:0 9rpx 0 #b4dc9c;overflow:hidden}.head-copy{position:relative;z-index:2}.head-kicker{color:#46a302;font-weight:900;font-size:24rpx}.head-title{font-size:48rpx;line-height:1.2;font-weight:900;margin:8rpx 0 24rpx;color:#27313a}.head-cat{width:190rpx;height:190rpx;border-radius:50%;border:8rpx solid #fff;background:#fff;box-shadow:0 8rpx 0 #a9d88d;animation:mascotFloat 3s ease-in-out infinite}.city{display:inline-flex;align-items:center;font-size:27rpx;font-weight:900;background:#fff;color:#46a302;padding:12rpx 20rpx;border:3rpx solid #bceca0;border-radius:999rpx;box-shadow:0 5rpx 0 #bceca0}.city image{width:30rpx;height:30rpx;margin-right:10rpx}.chevron{width:13rpx;height:13rpx;border-right:4rpx solid #58cc02;border-bottom:4rpx solid #58cc02;transform:rotate(45deg);margin:-6rpx 0 0 14rpx}.content{padding:34rpx 24rpx 60rpx}.search{height:100rpx;background:#fff;border:4rpx solid #e5e9e2;border-radius:24rpx;padding:0 26rpx;box-shadow:0 7rpx 0 #d7ddd3;box-sizing:border-box}.search input{flex:1;font-size:30rpx;font-weight:650}.search-icon{width:42rpx;height:42rpx;margin-right:18rpx}.clear{color:#9ca4a8;font-size:38rpx}.gym-row{min-height:128rpx;background:#fff;border:4rpx solid #e5e9e2;border-radius:26rpx;margin-top:22rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;box-shadow:0 7rpx 0 #d7ddd3}.gym-row:active{transform:translateY(5rpx);box-shadow:0 2rpx 0 #d7ddd3}.brand-main{display:flex;align-items:center}.brand-main>image{width:70rpx;height:70rpx;border-radius:22rpx;margin-right:20rpx}.brand-fallback{width:70rpx;height:70rpx;border-radius:22rpx;background:#e9fbdc;margin-right:20rpx;display:flex;align-items:center;justify-content