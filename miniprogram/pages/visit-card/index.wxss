.form-card input,.form-card textarea { display:block; box-sizing:border-box; width:100%; margin-top:18rpx; padding:20rpx; background:#f6f8f9; border-radius:16rpx; }
.form-card textarea { min-height:150rpx; }
.primary { margin-top:24rpx; background:var(--color-accent); color:#fff; font-weight:900; }
.card-detail { text-align:center; padding:52rpx 34rpx; }.eyebrow { color:var(--color-accent); font-weight:900; }.gym-name { margin-top:16rpx; font-size:34rpx; font-weight:900; }.visits { margin:40rpx 0 16rpx; color:var(--color-accent-strong); font-size:58rpx; font-weight:900; }.note { margin:28rpx 0; padding:20rpx; border-radius:16rpx; background:#fff5f2; }
