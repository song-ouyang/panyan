<view class="page gym-detail-page">
  <view wx:if="{{initialLoading && !gym}}" class="gym-skeleton" aria-label="正在加载岩馆">
    <view class="skeleton-line skeleton-title"></view>
    <view class="skeleton-line skeleton-subtitle"></view>
    <view class="skeleton-pills">
      <view class="skeleton-block skeleton-pill"></view>
      <view class="skeleton-block skeleton-pill short"></view>
    </view>
    <view class="skeleton-block skeleton-submit"></view>
    <view class="route card skeleton-route" wx:for="{{skeletons}}" wx:key="*this">
      <view class="skeleton-block skeleton-grade"></view>
      <view class="route-body">
        <view class="skeleton-line skeleton-route-name"></view>
        <view class="skeleton-line skeleton-route-meta"></view>
      </view>
    </view>
  </view>

  <view class="inline-state" wx:if="{{error && !gym}}">
    <view class="state-title">暂时没能加载岩馆</view>
    <view class="state-detail">{{error}}</view>
    <button class="pressable" bindtap="retry">重新加载</button>
  </view>

  <view wx:if="{{gym}}" class="gym-content {{refreshing ? 'is-refreshing' : ''}}">
    <view class="refresh-status" wx:if="{{refreshing}}" aria-label="正在更新岩馆">正在更新</view>
    <view class="inline-error" wx:if="{{error}}">
      <text>{{error}}</text>
      <view class="pressable" role="button" bindtap="retry">重试</view>
    </view>

    <view class="title">{{gym.name}}</view>
    <view class="subtitle">{{gym.address}}</view>
    <scroll-view scroll-x class="sets" enhanced show-scrollbar="{{false}}">
      <view
        class="set-pill pressable {{setId===item.id?'active-set':''}}"
        wx:for="{{gym.routeSets}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="chooseSet"
        role="button"
        aria-label="切换到{{item.name}}"
      >{{item.name}}{{item.active?' · 当前':''}}</view>
    </scroll-view>
    <scroll-view scroll-x class="grades" enhanced show-scrollbar="{{false}}">
      <view
        class="grade-pill pressable {{grade===item?'active':''}}"
        wx:for="{{grades}}"
        wx:key="*this"
        data-grade="{{item}}"
        bindtap="chooseGrade"
        role="button"
        aria-label="筛选{{item}}难度"
      >{{item}}</view>
    </scroll-view>
    <button class="submit-route pressable" bindtap="submitRoute">＋ 标记并投稿新线路</button>
    <view class="visit-card card">
      <view class="visit-card-head"><view><view class="visit-card-title">岩友次卡分享</view><view class="muted">转赠到店次数，不含支付与官方核销</view></view><view class="visit-card-create pressable" bindtap="createVisitCard">分享次卡</view></view>
      <view class="visit-card-item pressable" wx:for="{{visitCards}}" wx:key="id" data-id="{{item.id}}" bindtap="openVisitCard">
        <view><view>{{item.title}}</view><view class="muted">剩余 {{item.visits_remaining}} 次 · {{item.creator_name}}</view></view><text>›</text>
      </view>
      <view class="muted" wx:if="{{!visitCards.length}}">暂时没有可领取的次卡</view>
    </view>

    <view class="routes-region {{routesRefreshing ? 'is-refreshing' : ''}}">
      <view class="routes-refresh" wx:if="{{routesRefreshing}}">正在更新线路</view>
      <view class="inline-error" wx:if="{{routesError}}">
        <text>{{routesError}}</text>
        <view class="pressable" role="button" bindtap="retryRoutes">重试</view>
      </view>
      <view
        class="route card pressable"
        wx:for="{{routes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="open"
        role="button"
        aria-label="查看线路{{item.name}}"
      >
        <view class="grade">{{item.grade}}</view>
        <view class="route-body">
          <view class="name">{{item.name}}</view>
          <view class="muted">{{item.wall_zone}} · {{item.color}}</view>
        </view>
        <view class="muted">{{item.send_count}}人完攀 ›</view>
      </view>
      <view class="empty" wx:if="{{!routesRefreshing && !routesError && !routes.length}}">这个难度还没有线路</view>
    </view>
  </view>
</view>
