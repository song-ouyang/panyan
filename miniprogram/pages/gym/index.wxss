.gym-detail-page { min-height: 100vh; }
.gym-content { opacity: 1; transition: opacity 160ms var(--ease-out); }
.gym-content.is-refreshing { opacity: .82; }
.sets,
.grades { white-space: nowrap; margin-top: 26rpx; }
.grades { margin-bottom: 26rpx; }
.set-pill,
.grade-pill {
  min-height: 80rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-weight: 800;
}
.active,
.active-set { color: #fff; background: var(--color-accent); }
.submit-route {
  margin-bottom: 24rpx;
  color: var(--color-accent-strong);
  font-weight: 900;
  background: #fff;
  border: 2rpx dashed rgba(242, 103, 79, .34);
  border-radius: 22rpx;
}
.routes-region { opacity: 1; transition: opacity 160ms var(--ease-out); }
.routes-region.is-refreshing { opacity: .68; }
.routes-refresh,
.refresh-status { min-height: 40rpx; display: flex; align-items: center; justify-content: center; color: var(--color-muted); font-size: 22rpx; }
.route { display: flex; align-items: center; }
.route-body { flex: 1; margin-left: 22rpx; }
.name { font-size: 32rpx; font-weight: 900; }
.inline-error { min-height: 70rpx; box-sizing: border-box; margin-bottom: 18rpx; padding: 12rpx 18rpx; display: flex; align-items: center; justify-content: space-between; color: var(--color-danger); font-size: 23rpx; background: #fff5f2; border-radius: var(--radius-small); }
.inline-error .pressable { min-width: 88rpx; min-height: 48rpx; display: flex; align-items: center; justify-content: flex-end; font-weight: 900; }
.state-title { color: var(--color-text); font-weight: 900; }
.state-detail { margin-top: 8rpx; font-size: 23rpx; }
.skeleton-title { width: 54%; height: 42rpx; }
.skeleton-subtitle { width: 68%; height: 22rpx; margin-top: 18rpx; }
.skeleton-pills { display: flex; margin-top: 36rpx; }
.skeleton-pill { width: 180rpx; height: 80rpx; margin-right: 12rpx; border-radius: 999rpx; }
.skeleton-pill.short { width: 130rpx; }
.skeleton-submit { height: 88rpx; margin-top: 28rpx; }
.skeleton-route { min-height: 130rpx; }
.skeleton-grade { width: 70rpx; height: 70rpx; border-radius: 20rpx; }
.skeleton-route-name { width: 44%; height: 26rpx; }
.skeleton-route-meta { width: 62%; height: 18rpx; margin-top: 15rpx; }

@media (prefers-reduced-motion: reduce) {
  .gym-content,
  .routes-region { transition: opacity 120ms ease; }
}
