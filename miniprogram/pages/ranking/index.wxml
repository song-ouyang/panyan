<view class="page">
  <view class="title">抱石联赛</view><view class="subtitle">每一次完攀和点赞，都值得被看见。</view>
  <view class="scope-tabs"><view wx:for="{{scopes}}" wx:key="key" class="{{scope===item.key?'active':''}}" data-scope="{{item.key}}" bindtap="scope">{{item.label}}</view></view>
  <view class="region-pickers" wx:if="{{scope!=='national'}}"><picker range="{{provinces}}" value="{{provinceIndex}}" bindchange="chooseProvince"><view class="gym-picker">{{provinces[provinceIndex]}}⌄</view></picker><picker wx:if="{{scope==='city'}}" range="{{cities}}" value="{{cityIndex}}" bindchange="chooseCity"><view class="gym-picker">{{cities[cityIndex]}}⌄</view></picker></view>
  <view class="league card"><view class="league-icon"><image src="/assets/icons/fire.png"/></view><view class="league-info"><view class="league-title">烈焰联赛</view><view class="league-sub">本月积分榜 · 每月1日重新开始</view><view class="progress"><view class="progress-fill"></view></view></view><image class="league-cat" src="/assets/mascot-celebrate.jpg" mode="aspectFit"/></view>
  <view class="tabs"><view class="{{tab==='users'?'active':''}}" data-tab="users" bindtap="tab">岩友积分榜</view><view class="{{tab==='routes'?'active':''}}" data-tab="routes" bindtap="tab">热门线路</view></view>
  <block wx:if="{{tab==='users'}}">
    <view class="podium" wx:if="{{podium.length}}"><view class="podium-item place-{{item.rank}}" wx:for="{{podium}}" wx:key="user_id" data-id="{{item.user_id}}" bindtap="openUser"><view class="crown"><image wx:if="{{item.rank===1}}" src="/assets/icons/ranking-active.png"/><text wx:else>{{item.rank}}</text></view><image src="{{item.avatar_url || '/assets/logo.png'}}"/><view class="podium-name">{{item.nickname}}</view><view class="podium-score">{{item.points}} 分</view><view class="stand">{{item.rank}}</view></view></view>
    <view class="my-rank card" wx:if="{{myRank}}" data-id="{{myRank.user_id}}" bindtap="openUser"><image src="{{myRank.avatar_url || '/assets/logo.png'}}"/><view class="my-info"><view>我的本月排名</view><view class="muted">{{myRank.send_count}}条完攀 · {{myRank.total_likes}}赞</view></view><view class="my-place">第 {{myRank.rank}} 名<text>{{myRank.points}} 分</text></view></view>
    <view class="card rank" wx:for="{{rest}}" wx:key="user_id" data-id="{{item.user_id}}" bindtap="openUser"><view class="place">{{item.rank}}</view><image class="avatar" src="{{item.avatar_url || '/assets/logo.png'}}"/><view class="person"><view>{{item.nickname}}</view><view class="muted">{{item.send_count}}条完攀 · 最高V{{item.max_grade}}</view></view><view class="points">{{item.points}}<text>分</text></view></view>
    <view class="score-rule card" wx:if="{{scoring}}"><view class="rule-title">本月加分规则</view><view class="rule-grid"><text>完攀 +{{scoring.completion}}</text><text>每级难度 +{{scoring.gradeStep}}</text><text>Flash +{{scoring.flash}}</text><text>每个赞 +{{scoring.like}}</text></view></view>
    <view class="empty" wx:if="{{!loading && !items.length}}">本月榜单还在等第一位岩友</view>
  </block>
  <block wx:if="{{tab==='routes'}}"><view class="route-rank card" wx:for="{{routes}}" wx:key="route_id" data-id="{{item.route_id}}" bindtap="openRoute"><view class="grade">{{item.grade}}</view><view class="route-info"><view class="route-name">{{item.route_name}}</view><view class="muted">{{item.gym_name}} · {{item.wall_zone || item.color}}</view><view class="route-stats"><view><image src="/assets/icons/check.png"/>{{item.completion_count}}人完攀</view><view><image src="/assets/icons/heart.png"/>{{item.total_likes}}赞</view></view></view><view class="round-arrow"></view></view></block>
</view>
