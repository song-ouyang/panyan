.route-cover{height:620rpx;border-radius:36rpx;background:#edf1eb;position:relative;overflow:hidden;border:4rpx solid #e5e9e2;box-shadow:0 8rpx 0 #d7ddd3}.route-cover image{width:100%;height:100%}.hold{width:190rpx;height:120rpx;background:#58cc02;border-radius:55% 45% 60% 40%;position:absolute;left:50%;top:40%;transform:translate(-50%,-50%) rotate(-12deg)}.marker{position:absolute;width:42rpx;height:42rpx;margin:-21rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#58cc02;color:#fff;border:4rpx solid #fff;font-size:18rpx;box-shadow:0 3rpx 12rpx rgba(0,0,0,.3)}.marker.start{background:#1cb0f6}.marker.finish{background:#27313a}.heading{margin-top:30rpx}.line{margin-top:26rpx}.action{margin-top:36rpx}.leader-title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:54rpx}.leader-title>view:first-child>text{font-size:36rpx;font-weight:900}.people{color:#58cc02;font-weight:900}.send-card.top{border-color:#bceca0}.send-head{display:flex;align-items:center}.rank{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:30rpx}.rank-1{color:#dca900}.rank-2{color:#8491a3}.rank-3{color:#bd7445}.sender{flex:1;margin-left:18rpx;font-weight:800}.likes{color:#ff4b4b;font-size:30rpx;font-weight:900}.send-card video{width:100%;height:600rpx;border-radius:20rpx;margin-top:22rpx}.send-foot{margin-top:20rpx;font-size:25rpx}
