.profile-card{display:flex;align-items:center;background:#fff0e8}.profile-card>image{width:120rpx;height:120rpx;border-radius:50%;border:6rpx solid #ff684a}.profile-copy{flex:1;margin-left:22rpx}.small{font-size:38rpx}.add{font-size:22rpx;margin:0;padding:0 20rpx;line-height:62rpx}.friend-state{color:#9b6dff;font-weight:900}.stats{display:flex;justify-content:space-around;text-align:center}.stats view{display:flex;flex-direction:column}.stats text{font-size:42rpx;font-weight:900;color:#ff684a}.stats label{font-size:22rpx;color:#8b837b}.section-title{font-size:34rpx;font-weight:900;margin-top:42rpx}.month-title{font-size:34rpx;font-weight:900;color:#9b6dff}.gym-block{padding:22rpx 0;border-bottom:2rpx solid #f0e7de}.gym-block:last-child{border:0}.gym-name{display:flex;align-items:center;gap:10rpx;font-weight:900}.gym-name image{width:34rpx;height:34rpx}.grade-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.grade-chip{background:#fff0e8;color:#ff684a;border:2rpx solid #ffd3c7;border-radius:16rpx;padding:10rpx 14rpx;font-weight:900}.grade-chip text{color:#7b746c;font-size:21rpx;margin-left:8rpx}
