.profile-card{display:flex;align-items:center;background:#fff}.profile-card>image{width:120rpx;height:120rpx;border-radius:50%;border:4rpx solid #e7e8e5}.profile-copy{flex:1;margin-left:22rpx}.small{font-size:38rpx}.add{min-height:72rpx;font-size:22rpx;margin:0;padding:0 20rpx;line-height:72rpx}.friend-state{color:var(--color-muted);font-weight:800}.stats{display:flex;justify-content:space-around;text-align:center}.stats view{display:flex;flex-direction:column}.stats text{font-size:42rpx;font-weight:900;color:var(--color-text)}.stats label{font-size:22rpx;color:var(--color-muted)}.section-title{font-size:34rpx;font-weight:900;margin-top:42rpx}.month-title{font-size:34rpx;font-weight:900;color:var(--color-text)}.gym-block{padding:22rpx 0;border-bottom:2rpx solid #eff0ed}.gym-block:last-child{border:0}.gym-name{display:flex;align-items:center;gap:10rpx;font-weight:900}.gym-name image{width:34rpx;height:34rpx}.grade-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.grade-chip{background:#f5f6f4;color:var(--color-accent-strong);border:2rpx solid #e7e8e5;border-radius:16rpx;padding:10rpx 14rpx;font-weight:900}.grade-chip text{color:var(--color-muted);font-size:21rpx;margin-left:8rpx}
