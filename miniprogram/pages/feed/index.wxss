page {
  background: #fff;
  color: #202124;
}

.moments-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 190rpx;
  background: #fff;
}

.feed-scopes { display: flex; gap: 12rpx; padding: 20rpx 0 4rpx; }
.feed-scopes button { flex: 1; min-height: 88rpx; margin: 0; border-radius: 22rpx; background: #fff8e9; color: #69777e; font-size: 28rpx; font-weight: 800; }
.feed-scopes button::after { border: 0; }
.feed-scopes .selected { background: #fff0e7; color: #eb644f; }
.favorite-button { white-space: nowrap; }
.favorite-button.favorited { color: #9c710b; }
.star { font-size: 31rpx; }

/* A feed should read as one continuous surface, not a stack of cards. */
.moment {
  display: flex;
  padding: 34rpx 0 30rpx;
  border-bottom: 2rpx solid #f0f1f3;
}

.moment-entering {
  animation: momentEnter 220ms cubic-bezier(.23, 1, .32, 1) both;
}

.moment-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 50%;
  background: #f2f3f5;
}

.moment-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.moment-name {
  position: relative;
  display: inline-flex;
  min-height: 44rpx;
  max-width: 100%;
  align-items: center;
  color: #3c4652;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-name::after {
  position: absolute;
  top: 50%;
  right: -12rpx;
  left: -12rpx;
  height: 88rpx;
  content: '';
  transform: translateY(-50%);
}

.moment-caption {
  margin: 10rpx 0 0;
  color: #202124;
  font-size: 29rpx;
  line-height: 1.62;
  word-break: break-word;
}

.moment-body video {
  width: 100%;
  height: 560rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #f3f4f5;
  overflow: hidden;
}

.image-grid {
  display: grid;
  max-width: 520rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.image-grid image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 6rpx;
  background: #f2f3f5;
}

.images-1 {
  max-width: 430rpx;
  grid-template-columns: 1fr;
}

.images-1 image {
  aspect-ratio: 1.22;
  border-radius: 14rpx;
}

.images-2,
.images-4 {
  max-width: 486rpx;
  grid-template-columns: repeat(2, 1fr);
}

.route-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 17rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f7f8;
}

.route-grade {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #2f343a;
  color: #fff;
  font-weight: 900;
}

.route-name { color: #25282c; font-weight: 850; }
.route-place { margin-top: 4rpx; color: #81868c; font-size: 21rpx; }

.moment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
  color: #969ba1;
  font-size: 21rpx;
}

.location { color: #68717c; }

.moment-actions {
  display: flex;
  align-items: center;
  gap: 2rpx;
  margin-top: 4rpx;
}

.action-btn,
.share-button {
  min-width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #62686f;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1;
}

.share-button::after { border: 0; }
.heart { font-size: 31rpx; line-height: 1; transform-origin: center; }
.liked { color: #eb644f; }
.confirmed .heart { animation: heartConfirm 220ms cubic-bezier(.23, 1, .32, 1); }
.comment-icon { font-size: 31rpx; line-height: .8; }

.image-grid .pressable:active { transform: scale(.99); }
.is-disabled { opacity: .5; }

.camera-fab {
  position: fixed;
  right: 30rpx;
  bottom: 150rpx;
  z-index: 20;
  min-width: 132rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: #f2674f;
  box-shadow: 0 10rpx 24rpx rgba(220, 80, 59, .2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
}

.camera-icon { font-size: 35rpx; font-weight: 400; line-height: 1; }

.refresh-indicator {
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #858a90;
  font-size: 21rpx;
}

.refresh-indicator view {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #e4e6e8;
  border-top-color: #f2674f;
  border-radius: 50%;
  animation: spin .7s linear infinite;
}

.inline-error {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 2rpx;
  padding: 0 20rpx;
  border: 2rpx solid #f2d8d3;
  border-radius: 16rpx;
  background: #fff;
  color: #855047;
  font-size: 23rpx;
}

.inline-error view {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #d9533e;
  font-weight: 850;
}

.feed-state {
  min-height: 64vh;
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 30rpx;
  text-align: center;
}

.empty-state image {
  width: 280rpx;
  height: 220rpx;
  animation: none !important;
}

.state-mark {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f7f8f9;
  color: #d9533e;
  font-size: 38rpx;
  font-weight: 900;
}

.state-title { margin-top: 22rpx; color: #24272b; font-size: 32rpx; font-weight: 900; }
.state-copy { max-width: 480rpx; margin-top: 10rpx; color: #81868c; font-size: 24rpx; line-height: 1.5; }

.state-action {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 0 30rpx;
  border-radius: 20rpx;
  background: #f2674f;
  color: #fff;
  font-weight: 850;
}

.feed-skeleton { padding-top: 8rpx; }
.skeleton-row { display: flex; padding: 32rpx 0; border-bottom: 2rpx solid #f0f1f3; }
.skeleton-avatar { width: 88rpx; height: 88rpx; flex: none; border-radius: 50%; }
.skeleton-body { flex: 1; margin-left: 20rpx; }
.skeleton-name { width: 32%; height: 24rpx; border-radius: 7rpx; }
.skeleton-line { width: 88%; height: 20rpx; margin-top: 22rpx; border-radius: 7rpx; }
.skeleton-line.short { width: 58%; margin-top: 12rpx; }
.skeleton-image { width: 72%; height: 230rpx; margin-top: 22rpx; border-radius: 14rpx; }
.skeleton-shimmer { background: #f0f1f2; animation: feedSkeletonPulse 850ms ease-in-out infinite alternate; }

/* Bottom composer: quick, spatial, and interruptible. */
.composer-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  pointer-events: none;
  opacity: 0;
  background: rgba(20, 22, 24, .44);
  transition: opacity 140ms cubic-bezier(.23, 1, .32, 1);
}

.composer-mask.visible {
  pointer-events: auto;
  opacity: 1;
  transition-duration: 180ms;
}

.composer-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  max-height: calc(92vh - env(safe-area-inset-top));
  box-sizing: border-box;
  overflow-y: auto;
  padding: 16rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  box-shadow: 0 -18rpx 54rpx rgba(21, 24, 28, .14);
  opacity: 0;
  pointer-events: none;
  transform: translateY(100%);
  transition: transform 180ms cubic-bezier(.32, .72, 0, 1), opacity 140ms cubic-bezier(.23, 1, .32, 1);
}

.composer-sheet.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
  transition-duration: 240ms, 180ms;
}

.composer-handle { width: 70rpx; height: 8rpx; margin: 0 auto 12rpx; border-radius: 999rpx; background: #d8dadd; }
.composer-head { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; color: #24272b; font-weight: 850; }
.composer-cancel { min-width: 88rpx; min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; padding: 0 8rpx; color: #5f656c; }

.composer-submit {
  min-width: 104rpx;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 23rpx;
  border-radius: 20rpx;
  background: #f2674f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1;
}

.composer-submit[disabled] { background: #d7dade; color: #fff; }
.composer-submit.is-complete,
.composer-submit.is-complete[disabled] {
  background: #3f8c67;
  box-shadow: 0 2rpx 0 #2f7151;
  opacity: 1;
  animation: publishComplete 220ms cubic-bezier(.23, 1, .32, 1) both;
}
.composer-submit.is-pending,
.composer-submit.is-pending[disabled] {
  min-width: 178rpx;
  background: #766545;
  box-shadow: 0 2rpx 0 #5f5037;
  animation: publishPending 180ms cubic-bezier(.23, 1, .32, 1) both;
}
.composer-submit::after { border: 0; }
.composer-sheet textarea { width: 100%; height: 170rpx; box-sizing: border-box; padding: 22rpx 0; color: #202124; font-size: 29rpx; line-height: 1.5; }
.draft-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.draft-image, .add-image { position: relative; aspect-ratio: 1; }
.draft-image image { width: 100%; height: 100%; border-radius: 12rpx; }
.remove-image { position: absolute; top: -22rpx; right: -22rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: transparent; color: #fff; }
.remove-glyph { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(28, 31, 34, .9); font-size: 27rpx; line-height: 1; }

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cfd3d7;
  border-radius: 12rpx;
  background: #f7f8f9;
  color: #656b72;
}

.add-image text { font-size: 48rpx; font-weight: 300; line-height: 1; }
.add-image label { margin-top: 8rpx; font-size: 21rpx; }
.composer-tip { margin-top: 15rpx; color: #7d838a; font-size: 20rpx; }

.publish-progress {
  margin-top: 18rpx;
  padding: 17rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f7f8;
}

.progress-copy { display: flex; align-items: center; justify-content: space-between; color: #50565d; font-size: 22rpx; font-weight: 800; }
.progress-track { height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: #dfe2e5; }
.progress-track view { height: 100%; border-radius: 999rpx; background: #f2674f; transform-origin: left center; transition: transform 160ms cubic-bezier(.23, 1, .32, 1); }
.publish-error { margin-top: 16rpx; padding: 14rpx 16rpx; border: 2rpx solid #f1d5cf; border-radius: 14rpx; background: #fff; color: #9f3b2d; font-size: 22rpx; }
.publish-review-note {
  margin-top: 16rpx;
  color: #766545;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.45;
  opacity: 0;
}
.publish-review-note.visible { animation: publishPending 180ms cubic-bezier(.23, 1, .32, 1) both; }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes heartConfirm { 0% { transform: scale(.9); } 55% { transform: scale(1.16); } 100% { transform: scale(1); } }
@keyframes feedSkeletonPulse { from { opacity: .52; } to { opacity: .88; } }
@keyframes momentEnter {
  from { opacity: 0; transform: translateY(-8rpx) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes publishComplete {
  from { opacity: .6; transform: scale(.96); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes publishPending { from { opacity: 0; } to { opacity: 1; } }

@media (prefers-reduced-motion: reduce) {
  .composer-mask, .composer-sheet { transition: opacity 140ms ease !important; transform: none !important; }
  .composer-sheet { opacity: 0; }
  .composer-sheet.visible { opacity: 1; }
  .progress-track view { transition: none !important; }
  .skeleton-shimmer, .refresh-indicator view, .confirmed .heart { animation: none !important; }
  .moment-entering,
  .composer-submit.is-complete,
  .composer-submit.is-pending,
  .publish-review-note.visible { animation: feedReducedFade 160ms linear both !important; }
}

@keyframes feedReducedFade { from { opacity: 0; } to { opacity: 1; } }
