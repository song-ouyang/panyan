page{background:#fff}.moments-page{padding:0 30rpx 180rpx}.moment{display:flex;padding:30rpx 0;border-bottom:2rpx solid #eee8e2}.moment-avatar{width:78rpx;height:78rpx;border-radius:18rpx;background:#fff4e9;flex:none}.moment-body{flex:1;min-width:0;margin-left:20rpx}.moment-name{color:#8054a8;font-weight:900;font-size:29rpx}.moment-caption{font-size:29rpx;line-height:1.55;margin:12rpx 0;color:#292725}.moment-body video{width:100%;height:560rpx;border-radius:8rpx;background:#f1ede9;margin-top:14rpx}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7rpx;margin-top:14rpx;max-width:520rpx}.image-grid image{width:100%;aspect-ratio:1;background:#f2efec}.images-1{grid-template-columns:1fr;max-width:420rpx}.images-1 image{aspect-ratio:1.25}.images-2,.images-4{grid-template-columns:repeat(2,1fr);max-width:480rpx}.route-card{display:flex;align-items:center;gap:16rpx;background:#f7f4f1;border-radius:10rpx;padding:16rpx;margin-top:14rpx}.route-grade{width:58rpx;height:58rpx;border-radius:14rpx;background:#ff6b4a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900}.route-name{font-weight:900}.route-place{font-size:21rpx;color:#8b817a;margin-top:4rpx}.moment-meta{display:flex;gap:18rpx;margin-top:16rpx;color:#a09791;font-size:21rpx}.location{color:#8054a8}.moment-actions{display:flex;align-items:center;gap:22rpx;margin-top:16rpx}.action-btn,.moment-actions button{font-size:23rpx;color:#6f6863;background:#f0eeec;border-radius:8rpx;padding:12rpx 18rpx;line-height:1;font-weight:800;margin:0}.action-btn:active,.moment-actions button:active{transform:scale(.92)}.action-btn.liked{color:#ff4b4b;background:#fff0ee}.moment-actions button::after{border:0}.camera-fab{position:fixed;right:30rpx;bottom:150rpx;height:76rpx;background:#ff6b4a;color:#fff;border-radius:999rpx;padding:0 24rpx;display:flex;align-items:center;gap:10rpx;font-size:30rpx;font-weight:900;box-shadow:0 7rpx 0 #d94d34;z-index:20}.camera-fab text{font-size:23rpx}.camera-fab:active{transform:translateY(5rpx);box-shadow:0 2rpx 0 #d94d34}.composer-mask{position:fixed;inset:0;background:rgba(0,0,0,.38);z-index:80}.composer-sheet{position:fixed;left:0;right:0;bottom:0;z-index:81;background:#fff;border-radius:34rpx 34rpx 0 0;padding:24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));box-shadow:0 -10rpx 30rpx rgba(0,0,0,.12)}.composer-head{display:flex;align-items:center;justify-content:space-between;font-weight:900}.composer-head>text{color:#777}.composer-head button{margin:0;padding:0 24rpx;line-height:58rpx;background:#ff6b4a;color:#fff;border-radius:999rpx;font-size:24rpx}.composer-head button::after{border:0}.composer-sheet textarea{width:100%;height:170rpx;box-sizing:border-box;padding:22rpx 0;font-size:29rpx}.draft-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.draft-image,.add-image{aspect-ratio:1;position:relative}.draft-image image{width:100%;height:100%;border-radius:10rpx}.draft-image view{position:absolute;right:-8rpx;top:-8rpx;width:40rpx;height:40rpx;border-radius:50%;background:rgba(0,0,0,.72);color:#fff;display:flex;align-items:center;justify-content:center}.add-image{background:#f3f1ef;border-radius:10rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8b817a}.add-image text{font-size:50rpx;font-weight:300}.add-image label{font-size:21rpx}.composer-tip{font-size:20rpx;color:#aaa09a;margin-top:14rpx}
