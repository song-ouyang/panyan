<view class="page"><view class="title">我的线路投稿</view><view class="card item" wx:for="{{items}}" wx:key="id"><image src="{{item.cover_url}}" mode="aspectFill"/><view class="body"><view class="between"><view class="name">{{item.name}}</view><view class="status {{item.status}}">{{item.status==='pending'?'审核中':item.status==='approved'?'已发布':'未通过'}}</view></view><view class="muted">{{item.gym_name}} · {{item.grade}} · {{item.color}}</view><view wx:if="{{item.review_note}}" class="note">{{item.review_note}}</view></view></view><view class="empty" wx:if="{{!items.length}}">还没有投稿过线路</view></view>
