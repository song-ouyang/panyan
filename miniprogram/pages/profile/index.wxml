<view class="page"><block wx:if="{{me}}"><view class="row profile" bindtap="edit"><image class="avatar big" src="{{me.avatar_url || '/assets/logo.png'}}"/><view class="profile-text"><view class="title small">{{me.nickname}}</view><view class="muted">{{me.bio || '保持上墙，持续成长'}}</view></view><text class="muted">编辑 ›</text></view>
<view class="growth-hero card"><view class="growth-cat"><image src="/assets/mascot-welcome.jpg" mode="aspectFit"/></view><view class="between"><view class="growth-title">本月攀爬进度</view><view class="growth-streak"><image src="/assets/icons/fire.png"/>{{me.stats.monthly_sends}} 次</view></view><view class="growth-stats"><view><text>{{me.stats.monthly_sends}}</text><label>完攀</label></view><view><text>V{{me.stats.monthly_max_grade}}</text><label>最高</label></view><view><text>{{dashboard.summary.gyms}}</text><label>岩馆</label></view></view></view>
<view class="stats card"><view><text>{{me.stats.total_sends}}</text><label>总完攀</label></view><view><text>V{{me.stats.max_grade}}</text><label>最高难度</label></view><view><text>{{me.stats.gym_count}}</text><label>去过岩馆</label></view></view>
<view class="section-title">攀岩日历</view>
<view class="calendar-card card">
  <view class="calendar-head"><view class="month-arrow" bindtap="previousMonth">‹</view><view class="month-title">{{monthLabel}}</view><view class="month-arrow" bindtap="nextMonth">›</view></view>
  <view class="week-row"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
  <view class="calendar-grid"><view wx:for="{{calendar}}" wx:key="index" class="calendar-day {{item.muted?'muted-day':''}} {{item.active?'active-day':''}}" data-item="{{item}}" bindtap="selectDay"><text>{{item.number}}</text><label wx:if="{{item.active}}">{{item.sends}}</label></view></view>
</view>
<view class="day-detail card" wx:if="{{selectedDay}}"><view class="between"><view class="day-title">{{selectedDay.date}} 攀爬记录</view><view class="day-total">{{selectedDay.sends}} 条</view></view><view class="day-row" wx:for="{{selectedDay.details}}" wx:key="index"><text>{{item.gym_name}}</text><view class="tag">{{item.grade}} · {{item.sends}}条</view></view></view>
<view class="month-summary card" wx:if="{{dashboard}}"><view><text>{{dashboard.summary.climbing_days}}</text><label>攀爬天数</label></view><view><text>V{{dashboard.summary.max_grade}}</text><label>最高完攀</label></view><view><text>{{dashboard.summary.sends}}</text><label>线路数量</label></view></view>
<view class="achievement-row" wx:if="{{dashboard}}"><view class="achievement flash"><view class="achievement-label">Flash 卡</view><view class="achievement-value">一次完成 <text>{{dashboard.summary.flashes}}</text> 条</view></view><view class="achievement video"><view class="achievement-label">记录卡</view><view class="achievement-value">上传了 <text>{{dashboard.summary.videos}}</text> 段视频</view></view></view>
<view class="section-title">本月岩馆</view><view class="gym-stat card" wx:for="{{dashboard.byGym}}" wx:key="gym_id"><view class="gym-name">{{item.gym_name}}</view><text>{{item.sends}} 条</text></view><view class="empty small-empty" wx:if="{{dashboard && !dashboard.byGym.length}}">这个月还没有去岩馆</view>
<view class="section-title">本月难度分布</view><view class="chart card"><view class="bar-row" wx:for="{{dashboard.byGrade}}" wx:key="grade"><text>{{item.grade}}</text><view class="track"><view class="bar" style="width:{{item.sends/dashboard.summary.sends*100}}%"></view></view><text>{{item.sends}}条</text></view><view class="empty small-empty" wx:if="{{dashboard && !dashboard.byGrade.length}}">完成线路后会在这里生成月度分布</view></view>
<view class="section-title">V级完攀分布</view><view class="chart card"><view class="bar-row" wx:for="{{byGrade}}" wx:key="grade"><text>{{item.grade}}</text><view class="track"><view class="bar" style="width:{{item.sends/max*100}}%"></view></view><text>{{item.sends}}条</text></view><view class="empty small-empty" wx:if="{{!byGrade.length}}">完成线路后会在这里生成成长图</view></view>
<view class="section-title">岩馆足迹</view><view class="gym-stat card" wx:for="{{byGym}}" wx:key="gym_id"><view><view class="gym-name">{{item.gym_name}}</view><view class="muted">最高 V{{item.max_grade}}</view></view><text>{{item.sends}} 条</text></view>
<view class="section-title">本轮换线成绩</view><view class="cycle card" wx:for="{{cycles}}" wx:key="id"><view class="between"><view><view class="gym-name">{{item.gymName}}</view><view class="muted">{{item.setName}}</view></view></view><view class="grade-tags"><view class="tag" wx:for="{{item.grades}}" wx:for-item="gradeItem" wx:key="grade">{{gradeItem.grade}} · {{gradeItem.sends}}条</view></view></view><view class="empty" wx:if="{{!cycles.length}}">当前换线周期还没有完攀记录</view>
<view class="menu card" bindtap="notifications"><text>消息通知 <label wx:if="{{unread}}" class="badge">{{unread}}</label></text><text>›</text></view><view class="menu card" bindtap="posts">我的打卡动态 <text>›</text></view><view class="menu card" bindtap="meetups">我的约爬 <text>›</text></view><view class="menu card" bindtap="friends">我的岩友 <text>›</text></view><view class="menu card" bindtap="submissions">我的线路投稿 <text>›</text></view><view wx:if="{{me.role==='admin' || me.role==='gym_admin'}}" class="menu card admin" bindtap="admin">审核管理中心 <text>›</text></view><view class="menu card" bindtap="settings">设置与隐私 <text>›</text></view></block>
<view class="profile-state" wx:if="{{!me && loading}}"><image src="/assets/mascot-loading.jpg" mode="aspectFit"/><view class="state-title">正在整理你的攀爬记录</view><view class="loading-dots"><text></text><text></text><text></text></view></view>
<view class="profile-state" wx:if="{{!me && !loading}}"><image src="/assets/mascot-welcome.jpg" mode="aspectFit"/><view class="state-title">暂时没能加载成长记录</view><view class="muted">{{error || '点击下面按钮重新加载'}}</view><button class="primary retry" bindtap="retry">重新加载</button></view></view>
