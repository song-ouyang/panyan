.avatar-row{display:flex;flex-direction:column;align-items:center;margin:30rpx 0 50rpx}.avatar-button{padding:0;width:160rpx;height:160rpx;border:4rpx solid #e7e8e5;border-radius:50%;overflow:hidden;margin-bottom:16rpx;background:#fff}.avatar-button image{width:100%;height:100%}.field{margin-bottom:28rpx}.field label{display:block;font-weight:800;margin-bottom:14rpx}.field input,.field textarea{box-sizing:border-box;width:100%;background:#f5f6f4;border:2rpx solid transparent;border-radius:20rpx;padding:24rpx}.field input:focus,.field textarea:focus{background:#fff;border-color:#cfd3cf}.field textarea{height:220rpx}.save{margin-top:40rpx}
