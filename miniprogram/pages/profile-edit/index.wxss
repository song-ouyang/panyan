.avatar-row{display:flex;flex-direction:column;align-items:center;margin:30rpx 0 50rpx}.avatar-button{padding:0;width:160rpx;height:160rpx;border-radius:50%;overflow:hidden;margin-bottom:16rpx}.avatar-button image{width:100%;height:100%}.field{margin-bottom:28rpx}.field label{display:block;font-weight:700;margin-bottom:14rpx}.field input,.field textarea{box-sizing:border-box;width:100%;background:#fff;border-radius:20rpx;padding:24rpx}.field textarea{height:220rpx}.save{margin-top:40rpx}
