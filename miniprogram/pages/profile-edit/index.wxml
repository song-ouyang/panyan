<view class="page"><view class="avatar-row"><button class="avatar-button pressable" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image src="{{avatarUrl || '/assets/logo.png'}}"/></button><text class="muted">点击更换头像</text></view><view class="field"><label>昵称</label><input type="nickname" maxlength="32" value="{{nickname}}" data-key="nickname" bindinput="input" placeholder="你的岩友昵称"/></view><view class="field"><label>个人介绍</label><textarea maxlength="120" value="{{bio}}" data-key="bio" bindinput="input" placeholder="例如：深圳抱石，正在努力刷V4"/></view><button class="primary primary-action pressable save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存资料</button></view>
