.video{height:380rpx;display:flex;align-items:center;justify-content:center;text-align:center;border-style:dashed;border-color:#bceca0;background:#f8fff3}.video video{width:100%;height:100%;border-radius:20rpx}.plus{font-size:80rpx;color:#58cc02;font-weight:900}.video-title{font-size:30rpx;font-weight:900;margin-bottom:8rpx}.upload-box{text-align:center;padding-top:10rpx}.loading-cat{width:240rpx;height:190rpx;border-radius:36rpx;animation:mascotFloat 2.6s ease-in-out infinite}.upload-title{font-weight:900}.percent{color:#58cc02;font-weight:900}.progress{height:22rpx;background:#e5e9e2;border-radius:99rpx;overflow:hidden;margin-top:18rpx;border:2rpx solid #d7ddd3}.progress-fill{height:100%;background:linear-gradient(90deg,#1cb0f6,#58cc02);border-radius:99rpx;transition:width .2s}.loading-dots{display:flex;justify-content:center;gap:10rpx;margin-top:18rpx}.loading-dots text{width:12rpx;height:12rpx;background:#58cc02;border-radius:50%;animation:softPulse .9s infinite}.loading-dots text:nth-child(2){animation-delay:.15s}.loading-dots text:nth-child(3){animation-delay:.3s}.progress-tip{font-size:22rpx;margin-top:12rpx}.field{display:flex;justify-content:space-between}.field input{text-align:right;font-weight:900}.primary{margin-top:32rpx}textarea{width:100%;height:180rpx}.success-page{min-height:100vh;background:#f7faf5;text-align:center;padding:70rpx 38rpx 48rpx;box-sizing:border-box}.success-title{font-size:64rpx;color:#58cc02;font-weight:900}.success-cat{width:580rpx;height:580rpx;border-radius:60rpx;animation:mascotBounce 1.8s ease-in-out infinite}.success-copy{font-size:36rpx;font-weight:900}.success-sub{color:#7c868d;margin:16rpx 30rpx 60rpx}.success-button{width:100%}.milestone{display:inline-flex;background:#ffc800;color:#6d5200;border-radius:999rpx;padding:12rpx 28rpx;font-size:34rpx;font-weight:900;box-shadow:0 7rpx 0 #d9a900;margin-bottom:24rpx}.points-earned{display:inline-flex;background:#e9fbdc;color:#46a302;border:3rpx solid #bceca0;border-radius:16rpx;padding:10rpx 18rpx;margin-top:18rpx;font-weight:900}
