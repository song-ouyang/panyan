<view class="splash"><image class="splash-art" src="/assets/launch-hero-v2.jpg" mode="aspectFit"/><view class="enter-tip pressable primary-action motion-rise {{introVisible?'is-visible':''}}" wx:if="{{prepared && !showProfile}}" bindtap="enter" role="button" aria-label="进入完攀日记">点击进入</view><view class="preparing-tip motion-fade {{introVisible?'is-visible':''}}" wx:if="{{preparing}}">正在准备你的攀岩日记…</view></view>
<block wx:if="{{profileMounted}}">
  <view class="profile-mask {{profileVisible?'visible':''}}"></view>
  <view class="profile-sheet {{profileVisible?'visible':''}}" role="dialog" aria-label="设置头像和昵称"><view class="profile-title">认识一下吧</view><view class="profile-subtitle">设置头像和昵称，让岩友更容易找到你</view><button class="avatar-picker pressable" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择头像"><image src="{{avatarUrl || '/assets/logo.png'}}"/><view class="camera-dot">＋</view></button><input class="{{profileError && !nickname ? 'has-error' : ''}}" type="nickname" maxlength="32" value="{{nickname}}" bindinput="nickname" placeholder="输入你的微信昵称" aria-label="昵称"/><view class="profile-error" wx:if="{{profileError}}">{{profileError}}</view><button class="primary primary-action profile-confirm" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">进入完攀日记</button><view class="profile-skip pressable" bindtap="skip" role="button" aria-label="暂时跳过头像昵称设置">暂时跳过</view></view>
</block>
