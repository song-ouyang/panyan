<view class="splash" bindtap="enter"><image src="/assets/launch-hero-v2.jpg" mode="aspectFit"/><view class="enter-tip" wx:if="{{!showProfile}}">点击进入</view></view>
<view class="profile-mask" wx:if="{{showProfile}}"></view>
<view class="profile-sheet" wx:if="{{showProfile}}"><view class="profile-title">认识一下吧</view><view class="profile-subtitle">设置头像和昵称，让岩友更容易找到你</view><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image src="{{avatarUrl || '/assets/logo.png'}}"/><view class="camera-dot">＋</view></button><input type="nickname" maxlength="32" value="{{nickname}}" bindinput="nickname" placeholder="输入你的微信昵称"/><button class="primary profile-confirm" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">进入完攀日记</button><view class="profile-skip" bindtap="skip">暂时跳过</view></view>
