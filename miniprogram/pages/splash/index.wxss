page{background:#fff7ec;overflow:hidden}.splash{width:100vw;height:100vh;position:relative;overflow:hidden;background:#fff7ec}.splash>image{width:100%;height:100%;display:block}.enter-tip{position:absolute;left:50%;bottom:calc(34rpx + env(safe-area-inset-bottom));transform:translateX(-50%);color:#5f5148;background:rgba(255,255,255,.88);border:3rpx solid rgba(224,198,176,.8);border-radius:999rpx;padding:12rpx 34rpx;font-size:22rpx;font-weight:800;box-shadow:0 5rpx 0 rgba(202,170,145,.32)}
.profile-mask{position:fixed;inset:0;background:rgba(45,36,30,.42);z-index:30}.profile-sheet{position:fixed;left:36rpx;right:36rpx;top:50%;transform:translateY(-50%);z-index:31;background:#fffaf3;border:4rpx solid #f0d2bc;border-radius:36rpx;padding:38rpx 34rpx;text-align:center;box-shadow:0 12rpx 0 #dcbba3}.profile-title{font-size:42rpx;font-weight:900}.profile-subtitle{color:#8b817a;font-size:24rpx;margin:10rpx 0 28rpx}.avatar-picker{width:164rpx;height:164rpx;border-radius:50%;padding:0;position:relative;overflow:visible;background:#fff;margin:0 auto 28rpx}.avatar-picker image{width:100%;height:100%;border-radius:50%;border:5rpx solid #ffd5c6;box-sizing:border-box}.avatar-picker::after{border:0}.camera-dot{position:absolute;right:-2rpx;bottom:2rpx;width:48rpx;height:48rpx;background:#ff6b4a;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:900}.profile-sheet input{height:88rpx;background:#f4efea;border-radius:22rpx;padding:0 24rpx;text-align:left;font-size:29rpx}.profile-confirm{margin-top:26rpx}.profile-skip{color:#968d87;font-size:24rpx;margin-top:28rpx;padding:10rpx}
