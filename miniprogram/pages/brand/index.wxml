<view class="page" wx:if="{{brand}}"><view class="brand-head"><image src="{{brand.logo_url || '/assets/logo.png'}}"/><view><view class="title">{{brand.name}}</view><view class="subtitle">选择门店后查看本轮线路</view></view></view><view class="section-title">全部门店 · {{stores.length}}</view><view class="store card" wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view><view class="store-name">{{item.name}}</view><view class="muted">{{item.district}} · {{item.address}}</view><view class="stats">{{item.route_count}}条线路</view></view><text class="arrow">›</text></view></view>
