# The production image only builds the Fastify workspace. Keep Flutter,
# mini-program, local databases, credentials and generated artifacts out of
# the Docker build context so server deployments stay fast and reproducible.
*
!package.json
!package-lock.json
!server/
!server/Dockerfile
!server/package.json
!server/tsconfig.json
!server/src/
!server/src/**
!data/
!data/gyms.public-verified.json
