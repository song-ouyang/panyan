# 域名只填主机名，不要带 https://，并提前把 DNS A 记录指向服务器公网 IP
DOMAIN=panyan-api.gblh.cloud
ACME_EMAIL=ouyangsong8@gmail.com
API_HOST_PORT=3100

POSTGRES_DB=wanpan
POSTGRES_USER=wanpan
POSTGRES_PASSWORD=请替换为至少32位随机密码
# 新部署保持默认即可；只有旧版已在卷根目录建库时才改为 /var/lib/postgresql/data
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata

JWT_SECRET=请替换为openssl_rand_hex_32生成的值
WECHAT_APP_ID=wx87ff92b724ffea73
WECHAT_APP_SECRET=请填写重置后的新密钥
# 尚未申请微信开放平台「移动应用」时保持为空；不要填小程序凭据或示例文字
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=
APPLE_CLIENT_ID=com.wanpan.wanpanDiary
APPLE_TEAM_ID=WX547ZHMP5
# App Store 审核专用固定账号；请使用未公开且可定期轮换的 6 位验证码
APP_REVIEW_LOGIN_PHONE=请填写审核手机号
APP_REVIEW_LOGIN_CODE=请填写随机6位审核验证码
# 阿里云号码认证服务（Dypnsapi）；普通手机号登录需要完整配置以下四项
ALIYUN_ACCESS_KEY_ID=请填写RAM用户AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=请填写RAM用户AccessKeySecret
ALIYUN_SMS_SIGN_NAME=请填写号码认证服务签名
ALIYUN_SMS_TEMPLATE_CODE=请填写号码认证服务模板Code
ALIYUN_SMS_TEMPLATE_MIN=5

MODERATION_MODE=manual
# 默认硬拒绝生产数据库目录导入。仅在备份后执行独立 seed 命令时临时改为 true。
ALLOW_PRODUCTION_GYM_IMPORT=false
# 默认硬拒绝生产广场体验数据导入。不要长期改为 true，只能通过单次命令注入。
ALLOW_PRODUCTION_SQUARE_SEED=false
UPLOAD_MODE=oss
OSS_REGION=oss-cn-chengdu
OSS_BUCKET=crush-oss
OSS_ACCESS_KEY_ID=请填写RAM用户AccessKeyId
OSS_ACCESS_KEY_SECRET=请填写RAM用户AccessKeySecret
OSS_PUBLIC_BASE_URL=https://crush-oss.oss-cn-chengdu.aliyuncs.com
