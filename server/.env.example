NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wanpan
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# local: videos are uploaded to this server; presigned: provide your own object-storage adapter later
UPLOAD_MODE=local
# UPLOAD_MODE=oss 时填写以下配置；AccessKey 只放后端，绝不能写入小程序
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# off: local development; manual: new posts/comments wait for admin approval
MODERATION_MODE=off
