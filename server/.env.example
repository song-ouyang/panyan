NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wanpan
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信开放平台「移动应用」凭据，与上面的小程序凭据彼此独立
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=
# iOS App 的 Bundle ID（或对应 Services ID），必须与 Apple identity token aud 一致
APPLE_CLIENT_ID=com.wanpan.wanpanDiary
APPLE_TEAM_ID=WX547ZHMP5
# App Store 审核账号：此号码的验证码不依赖阿里云短信；仅通过部署密钥配置。
APP_REVIEW_LOGIN_PHONE=
APP_REVIEW_LOGIN_CODE=
# 阿里云号码认证服务（Dypnsapi）短信验证码。四项须同时设置；审核账号可不依赖它。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_MIN=5
# local: videos are uploaded to this server; presigned: provide your own object-storage adapter later
UPLOAD_MODE=local
# UPLOAD_MODE=oss 时填写以下配置；AccessKey 只放后端，绝不能写入小程序
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# off: local development; manual: new posts/comments wait for admin approval
MODERATION_MODE=off
# 生产环境导入公开岩馆目录时才临时设为 true；普通启动不会自动导入。
ALLOW_PRODUCTION_GYM_IMPORT=false
# 生产环境导入广场体验数据时才通过单次命令设为 true。
ALLOW_PRODUCTION_SQUARE_SEED=false
